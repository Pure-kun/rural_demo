/* 整页用 flex 纵向布局：头部固定、消息区滚动、输入条贴底 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-inner {
  padding: var(--sp-page);
  padding-top: var(--sp-4);
}

.bubble-row {
  display: flex;
  margin-bottom: var(--sp-2);
}

.bubble-row-user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  font-size: var(--fs-base);
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}

.bubble-ai {
  background: var(--c-card);
  color: var(--c-text);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bubble-user {
  background: var(--c-primary);
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
}

.bubble-tools {
  margin: -8rpx 0 var(--sp-4) 0;
}

.bubble-tool {
  font-size: var(--fs-xs);
  line-height: 1;
  color: var(--c-primary);
  background: var(--c-primary-light);
  border-radius: var(--r-sm);
  padding: 10rpx var(--sp-2);
}

.chat-note {
  font-size: var(--fs-xs);
  color: var(--c-text-weak);
  background: #EEF0EE;
  border-radius: var(--r-sm);
  padding: var(--sp-2) var(--sp-3);
  line-height: 1.5;
  margin-top: var(--sp-4);
}

.chat-holder {
  height: 24rpx;
}

/* 底部输入条（flex 布局，不再 fixed） */
.chat-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: var(--c-card);
  padding: var(--sp-2) var(--sp-3);
  padding-bottom: calc(var(--sp-2) + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 点击热区 ≥44pt */
.chat-mic {
  width: var(--hit-min);
  height: var(--hit-min);
  border-radius: 50%;
  background: var(--c-primary-light);
  color: var(--c-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
  flex-shrink: 0;
}

.chat-mic-recording {
  background: var(--c-danger);
  color: #FFFFFF;
}

.chat-input {
  flex: 1;
  height: var(--hit-min);
  background: var(--c-bg);
  border-radius: 44rpx;
  padding: 0 var(--sp-3);
  margin: 0 var(--sp-2);
  font-size: var(--fs-base);
}

.chat-send {
  flex-shrink: 0;
  height: var(--hit-min);
  padding: 0 var(--sp-3);
  background: var(--c-primary);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: var(--fs-base);
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
}

.chat-send-disabled {
  background: var(--c-disabled);
}
