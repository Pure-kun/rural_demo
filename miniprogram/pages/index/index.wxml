<view class="app-root {{themeClass}}">

  <page-header
    icon="🏡"
    title="{{greeting}}，{{userName}}"
    subtitle="{{todayText}}　有事随时找村里"
    theme="green" />

  <view class="page-body">

    <!-- 离线 / 待提交提示 -->
    <view class="offline-bar" wx:if="{{!isOnline || queueCount > 0}}">
      <text wx:if="{{!isOnline}}">当前网络不可用，显示的是已有内容</text>
      <text wx:elif="{{queueCount > 0}}">有 {{queueCount}} 条内容待提交，联网后会自动发送</text>
    </view>

    <!-- 工单概况（渐变卡，页面视觉重心） -->
    <view class="stat-gradient">
      <view class="stat-row">
        <view class="stat-item">
          <view class="stat-num">{{stats.pending}}</view>
          <view class="stat-label">等干部处理</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{stats.processing}}</view>
          <view class="stat-label">正在处理</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{stats.done}}</view>
          <view class="stat-label">已经办好</view>
        </view>
      </view>
      <view class="stat-line"></view>
      <view class="stat-more" bindtap="goList">
        <text>查看我的工单</text>
        <text>全部 ›</text>
      </view>
    </view>

    <!-- 三大入口 -->
    <view class="entry-grid">
      <view class="entry-card" bindtap="goSubmit">
        <view class="entry-icon entry-icon-green">📝</view>
        <view class="entry-main">
          <view class="entry-title">我要反映问题</view>
          <view class="entry-desc">说句话就行，不用打字</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>

      <view class="entry-card" bindtap="goNotices">
        <view class="entry-icon entry-icon-orange">📢</view>
        <view class="entry-main">
          <view class="entry-title">看通知</view>
          <view class="entry-desc">村里的最新消息</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>

      <view class="entry-card" bindtap="goAi">
        <view class="entry-icon entry-icon-purple">🤖</view>
        <view class="entry-main">
          <view class="entry-title">问 AI</view>
          <view class="entry-desc">政策不懂，问一句就明白</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
    </view>

    <!-- 一键拨号 -->
    <view class="call-bar mb-4" bindtap="onCall">📞 打电话给村干部</view>

    <!-- 最新通知 -->
    <view class="section">
      <view class="row-between mb-3">
        <text class="section-title" style="margin-bottom:0">最新通知</text>
        <text class="fs-sm text-primary" bindtap="goNotices">全部 ›</text>
      </view>

      <view wx:if="{{notices.length === 0}}" class="empty">
        <view class="empty-icon">📭</view>
        <view class="empty-text">暂时还没有通知</view>
      </view>

      <view
        wx:for="{{notices}}"
        wx:key="id"
        class="list-item"
        data-id="{{item.id}}"
        bindtap="goNoticeDetail">
        <view class="list-item-head">
          <text class="list-item-title">{{item.title}}</text>
          <text class="badge-dot" wx:if="{{item.isRead === 0}}">新</text>
        </view>
        <view class="list-item-desc">{{item.content}}</view>
        <view class="list-item-foot">
          <text>{{item.publisherName}}</text>
          <text>{{item.timeText}}</text>
        </view>
      </view>
    </view>

  </view>
</view>
