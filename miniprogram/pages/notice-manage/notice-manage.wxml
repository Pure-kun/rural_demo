<view class="app-root {{themeClass}}">
  <page-header
    icon="📢"
    title="公告管理"
    subtitle="发布、编辑和删除村务公告"
    theme="orange" />

  <view class="page-body">
    <button class="btn btn-primary btn-block mb-4" bindtap="addNotice">＋ 发布公告</button>

    <block wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-line sk-line-60"></view>
        <view class="sk-line sk-line-90"></view>
        <view class="sk-line sk-line-40"></view>
      </view>
    </block>

    <view class="empty" wx:elif="{{list.length === 0}}">
      <view class="empty-icon">📭</view>
      <view class="empty-text">暂时还没有公告</view>
    </view>

    <block wx:else>
      <view wx:for="{{list}}" wx:key="id" class="card notice-manage-card">
        <view class="notice-manage-head">
          <view class="flex-1">
            <view class="tag tag-pending mb-2" wx:if="{{item.isTop === 1}}">置顶</view>
            <view class="notice-manage-title">{{item.title}}</view>
          </view>
          <text class="notice-manage-time">{{item.timeText}}</text>
        </view>
        <view class="notice-manage-content">{{item.content}}</view>
        <view class="manage-actions">
          <button class="btn btn-secondary manage-btn" data-id="{{item.id}}" catchtap="editNotice">编辑</button>
          <button class="btn manage-btn manage-btn-danger" data-id="{{item.id}}" data-title="{{item.title}}" catchtap="deleteNotice">删除</button>
        </view>
      </view>
    </block>
  </view>
</view>
