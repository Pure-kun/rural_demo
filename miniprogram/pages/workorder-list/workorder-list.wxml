<view class="app-root {{themeClass}}">

  <page-header
    icon="📋"
    title="我的工单"
    subtitle="反映过的事，都在这儿"
    theme="green" />

  <view class="page-body">

    <view class="offline-bar" wx:if="{{!isOnline}}" style="border-radius: 24rpx; margin-bottom: 24rpx;">
      当前网络不可用，下面显示的是之前的内容
    </view>

    <!-- 状态筛选 -->
    <view class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab">{{item.label}}</view>
    </view>

    <!-- 加载中骨架 -->
    <block wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-line sk-line-60"></view>
        <view class="sk-line sk-line-90"></view>
        <view class="sk-line sk-line-40"></view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty" wx:elif="{{list.length === 0}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text">这里还没有内容</view>
      <button class="btn btn-primary mt-4" style="width: 60%;" bindtap="goSubmit">反映一个问题</button>
    </view>

    <!-- 列表 -->
    <block wx:else>
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="list-item"
        data-id="{{item.id}}"
        bindtap="goDetail">

        <view class="list-item-head">
          <text class="list-item-title">{{item.title}}</text>
          <view class="tag {{item.statusTag}}">
            <text>{{item.statusIcon}} {{item.statusText}}</text>
          </view>
        </view>

        <view class="list-item-desc">{{item.content}}</view>

        <view class="list-item-foot">
          <text>{{item.categoryText}}</text>
          <text>{{item.timeText}}</text>
        </view>

        <view class="wo-result" wx:if="{{item.result}}">
          <text class="wo-result-label">处理结果</text>
          <text class="wo-result-text">{{item.result}}</text>
        </view>
      </view>
    </block>

  </view>
</view>
