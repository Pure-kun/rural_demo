.wo-result {
  margin-top: var(--sp-3);
  background: var(--c-primary-light);
  border-radius: var(--r-sm);
  padding: var(--sp-3);
}

.wo-result-label {
  display: block;
  font-size: var(--fs-xs);
  color: var(--c-primary);
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 4rpx;
}

.wo-result-text {
  font-size: var(--fs-sm);
  color: var(--c-text);
  line-height: 1.5;
}
